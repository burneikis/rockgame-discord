# Copy to .env (never commit .env). Values from the Discord Developer Portal -> OAuth2.
VITE_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: comma-separated Discord user ids allowed to play (empty = anyone
# with a Discord account). Recommended when hosting publicly.
ALLOWED_DISCORD_IDS=
# Optional: Cloudflare named-tunnel token for a fixed hostname (docker compose only).
TUNNEL_TOKEN=
